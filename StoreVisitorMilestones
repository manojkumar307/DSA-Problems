    public static int countMilestones (int[] visits, long milestone) {
    	int count = 0;
    	int sum = 0;
    	
    	for (int i = 0; i < visits.length; i++) {
    		sum += visits[i];
    		if (sum >= milestone) {
    			return visits.length-i;
    		}
    	}
    	return 0;
    }
